local test = require("@std/test")
local task = require("@lute/task")
local process = require("@lute/process")

test.suite("TaskCancel", function(suite)
	suite:case("cancel_waiting_thread", function(assert)
		local reached = false
		local co = coroutine.create(function()
			task.wait(10)
			reached = true
		end)
		coroutine.resume(co)
		task.cancel(co)
		task.wait(0.1)
		assert.eq(reached, false)
	end)

	suite:case("cancel_noop_on_dead_thread", function(assert)
		local co = coroutine.create(function() end)
		coroutine.resume(co)
		task.cancel(co)
	end)

	suite:case("cancel_kills_child_process", function(assert)
		local co = coroutine.create(function()
			process.run({ "sleep", "60" })
		end)
		coroutine.resume(co)
		task.defer()
		task.cancel(co)
		task.defer()
		local check = process.system("pgrep -f 'sleep 60'")
		assert.eq(check.ok, false)
	end)
end)
