local process = require("@lute/process")
local task = require("@lute/task")
local test = require("@std/test")

test.suite("ProcessLifecycle", function(suite)
	suite:case("create_returns_handle", function(assert)
		local p = process.create({ "echo", "hello" })
		assert.neq(p, nil)
	end)

	suite:case("run_handle_returns_result", function(assert)
		local p = process.create({ "echo", "hello" })
		local result = process.run(p)
		assert.eq(result.ok, true)
		assert.eq(result.exitcode, 0)
		assert.strcontains(result.out, "hello")
	end)

	suite:case("run_handle_errors_if_already_spawned", function(assert)
		local p = process.create({ "echo", "hello" })
		process.run(p)
		assert.errors(function()
			process.run(p)
		end)
	end)

	suite:case("kill_terminates_running_process", function(assert)
		local p = process.create({ "sleep", "60" })
		local co = coroutine.create(function()
			process.run(p)
		end)
		coroutine.resume(co)
		task.defer()
		process.kill(p)
		task.defer()
		local check = process.system("pgrep -f 'sleep 60'")
		assert.eq(check.ok, false)
	end)

	suite:case("kill_noop_on_completed_process", function()
		local p = process.create({ "echo", "done" })
		process.run(p)
		process.kill(p)
	end)

	suite:case("backward_compat_run_with_args", function(assert)
		local result = process.run({ "echo", "compat" })
		assert.eq(result.ok, true)
		assert.strcontains(result.out, "compat")
	end)
end)
